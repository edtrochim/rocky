      <LC_LandCoverClass id="1B" uuid="3b54e540-fa71-11eb-9d5e-988d46a27cb3" xsi:type="LC_LandCoverClass">
         <name>Artifiicial surfaces</name>
         <description>The class is composed of any type of areas with a predominant artificial surface. Any urban or related feature is included in this class. The class also includes industrial areas, and waste dump deposit and extraction sites.</description>
         <map_code>ART</map_code>
