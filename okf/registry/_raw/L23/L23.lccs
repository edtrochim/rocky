   <elements>
      <LC_LandCoverClass id="2" uuid="2eb91150-fa6a-11eb-9d5e-988d46a27cb3" xsi:type="LC_LandCoverClass">
         <name>Woodland</name>
         <description>Land covered with trees; Vegetation dominated by closed thicket; Relatively dense woody growth form.</description>
         <map_code>WDL</map_code>
         <elements>
            <LC_HorizontalPattern id="3" uuid="3f185d40-fa6e-11eb-9d5e-988d46a27cb3" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="4" ontop="0" uuid="42d209e0-fa6e-11eb-9d5e-988d46a27cb3" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>Vegetation 1</description>
                     <elements>
                        <LC_LandCoverElement id="5" uuid="4b920760-fa6e-11eb-9d5e-988d46a27cb3" xsi:type="LC_Trees">
                           <name>Trees</name>
                           <description>Describe a vegetation element of trees type</description>
                           <elements>
                              <LC_Characteristic id="6" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <cover max="100.0" min="10.0"/>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
                  <LC_Stratum id="7" ontop="0" uuid="9f16d680-fa6f-11eb-9d5e-988d46a27cb3" xsi:type="LC_Stratum">
                     <name>Stratum 2</name>
                     <description>Vegetation 2</description>
                     <elements>
                        <LC_LandCoverElement id="8" uuid="a0314730-fa6f-11eb-9d5e-988d46a27cb3" xsi:type="LC_Shrubs">
                           <name>Shrubs</name>
                           <description>Describe a vegetation element of shrubs type</description>
                           <elements>
                              <LC_Characteristic id="9" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <cover max="100.0" min="10.0"/>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
