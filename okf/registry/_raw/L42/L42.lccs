<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<LC_Legend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="1" lccs_sort="0" uuid="dae049b0-a865-11ef-912b-e6c767bd34d6" xsi:noNamespaceSchemaLocation="Lebanon.xsd" xsi:type="LC_Legend">
   <name>Lebanon</name>
   <description>Land cover legend description for Lebanon. This land cover is selected from the national legend produced by CNRS in 2011 and 2017</description>
   <elements>
      <LC_LandCoverClass id="2" uuid="f8658220-a865-11ef-912b-e6c767bd34d6" xsi:type="LC_LandCoverClass">
         <name>Evergreen forest</name>
         <description>An evergreen forest is a type of forest where most of the trees retain their leaves throughout the year, regardless of seasonal changes. The evergreen forest in Lebanon included but not limited to Cupressus spp., Cedrus libani, Juniperus spp., and many others (CNRS, 2011). These forests are characterized by their lush, dense foliage that remains green year-round. The forest can be distinguished by using infrared bands. For the coniferous forests, the vegetation covers more than 70% of conifers and shrubs in the undergrowth (CNRS, 2011). </description>
         <map_code>Ef</map_code>
         <elements>
            <LC_HorizontalPattern id="3" uuid="1eaa9100-a866-11ef-912b-e6c767bd34d6" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="4" ontop="0" uuid="1ff05770-a866-11ef-912b-e6c767bd34d6" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>Vegetation 1</description>
                     <elements>
                        <LC_LandCoverElement id="5" uuid="20fdcfd0-a866-11ef-912b-e6c767bd34d6" xsi:type="LC_Trees">
                           <name>Trees</name>
                           <description>Describe a vegetation element of trees type</description>
                           <elements>
                              <LC_Characteristic id="7" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <portioning max="100.0" min="10.0"/>
                           <cover max="100.0" min="70.0"/>
                           <presence_type>Mandatory</presence_type>
                           <LC_WoodyGrowthLeafPhenology id="8" uuid="e3aec874-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafPhenology">
                              <name>Woody Growth Leaf Phenology</name>
                              <description>Contains the elements of Woody Growth Leaf Phenology</description>
                              <elements>
                                 <LC_WoodyLeafPhenology id="9" uuid="2fd4fde0-a8a6-11ef-8c76-e4c767bd34d7" xsi:type="LC_Evergreen">
                                    <name>Evergreen</name>
                                    <description>Describe an Evergreen leaf phenology element</description>
                                 </LC_WoodyLeafPhenology>
                              </elements>
                           </LC_WoodyGrowthLeafPhenology>
                           <height max="30.0" min="5.0"/>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
