                     <description>Vegetation 1</description>
                     <name>Stratum 1</name>
                     <elements>
                        <LC_LandCoverElement id="C" uuid="abe6f560-9ade-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_HerbaceousGrowthForms">
