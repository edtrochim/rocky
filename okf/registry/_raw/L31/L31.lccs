                                    <LC_Characteristic id="17" uuid="27a47290-43af-11de-bbd4-000cf147c442" xsi:type="LC_FieldSize">
                                       <description>Describe the field size</description>
                                       <name>Field Size</name>
                                       <size max="0.05" min="0.03"/>
