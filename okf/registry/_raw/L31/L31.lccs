                              <LC_Characteristic id="D" uuid="27a47287-43af-11de-bbd4-000cf147c442" xsi:type="LC_CultivatedAndManagedVegetation">
                                 <description>Describe the cultivated and managed vegetation</description>
                                 <name>Cultivated And Managed Vegetation</name>
                                 <elements>
                                    <LC_Characteristic id="E" uuid="55c4b640-915b-11de-bb5d-000cf147c442" xsi:type="LC_Irrigation">
                                       <description>Describe the irrigation</description>
                                       <name>Irrigation</name>
                                    </LC_Characteristic>
                                    <LC_Characteristic id="F" uuid="27a47290-43af-11de-bbd4-000cf147c442" xsi:type="LC_FieldSize">
                                       <description>Describe the field size</description>
                                       <name>Field Size</name>
                                       <size max="5.0" min="2.0"/>
                                    </LC_Characteristic>
                                 </elements>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
      <LC_LandCoverClass id="10" uuid="9d3c9320-9adf-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_LandCoverClass">
         <description>Farmland located parallel or close to the river, cultivated after flooding, mainly with vegetables. Small parcels (from 30 sqm to 50 sqm) aggregated in larger patterns. </description>
         <name>Seasonally flooded cropland</name>
         <map_code>SFC</map_code>
         <elements>
            <LC_HorizontalPattern id="11" uuid="af325a67-9adf-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_HorizontalPattern">
               <description>Describe the horizontal pattern</description>
               <name>Horizontal Pattern 1</name>
               <elements>
                  <LC_Stratum id="12" ontop="0" uuid="afeb4a20-9adf-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_Stratum">
