<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<LC_Legend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="1" lccs_sort="0" uuid="4709ab10-9aca-11ec-9aae-f0d5bf59e8a0" xsi:noNamespaceSchemaLocation="Chongoroi_Chipipa_Alto-Hama_Legend.xsd" xsi:type="LC_Legend">
   <description>Legend fo Angola</description>
   <name>Angola</name>
   <elements>
      <LC_LandCoverClass id="2" uuid="83510e20-9add-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_LandCoverClass">
         <description>Areas covered with herbaceous rainfed agricultural crops, mainly maize, cassava and beans, with parcels of 1 Ha on average. Main cropping seasons goes from September to March. </description>
         <name>Herbaceous rainfed cropland</name>
         <map_code>HRC</map_code>
         <elements>
            <LC_HorizontalPattern id="3" uuid="8be2a8a0-9add-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_HorizontalPattern">
               <description>Describe the horizontal pattern</description>
               <name>Horizontal Pattern 1</name>
               <elements>
                  <LC_Stratum id="4" ontop="0" uuid="900ec620-9add-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_Stratum">
                     <description>Vegetation 1</description>
                     <name>Stratum 1</name>
                     <elements>
                        <LC_LandCoverElement id="5" uuid="930e4a80-9add-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_HerbaceousGrowthForms">
                           <description>Describe a vegetation element of herbaceous growth form type</description>
                           <name>Herbaceous growth forms</name>
                           <elements>
                              <LC_Characteristic id="6" uuid="27a47287-43af-11de-bbd4-000cf147c442" xsi:type="LC_CultivatedAndManagedVegetation">
                                 <description>Describe the cultivated and managed vegetation</description>
                                 <name>Cultivated And Managed Vegetation</name>
                                 <elements>
                                    <LC_Characteristic id="7" uuid="55c4b63e-915b-11de-bb5d-000cf147c442" xsi:type="LC_Rainfed">
                                       <description>Describe the rainfed</description>
                                       <name>Rainfed</name>
                                    </LC_Characteristic>
                                    <LC_Characteristic id="8" uuid="27a47290-43af-11de-bbd4-000cf147c442" xsi:type="LC_FieldSize">
                                       <description>Describe the field size</description>
                                       <name>Field Size</name>
                                       <size max="1.5" min="0.5"/>
                                    </LC_Characteristic>
                                 </elements>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
      <LC_LandCoverClass id="9" uuid="27fcd120-9ade-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_LandCoverClass">
         <description>Areas covered with herbaceous irrigated crops, for commercial purposes, mainly banana, potato and tomato. Field size goes from 2 to 5 Ha. </description>
         <name>Commercial irrigated cropland</name>
         <map_code>CIC</map_code>
         <elements>
            <LC_HorizontalPattern id="A" uuid="a81b2050-9ade-11ec-9aae-f0d5bf59e8a0" xsi:type="LC_HorizontalPattern">
               <description>Describe the horizontal pattern</description>
               <name>Horizontal Pattern 1</name>
               <elements>
