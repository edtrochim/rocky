                                 <description>Describe the cultivated and managed vegetation</description>
                                 <name>Cultivated And Managed Vegetation</name>
                                 <elements>
                                    <LC_Characteristic id="15" uuid="55c4b63f-915b-11de-bb5d-000cf147c442" xsi:type="LC_Postflooding">
                                       <description>Describe the postflooding</description>
                                       <name>Postflooding</name>
