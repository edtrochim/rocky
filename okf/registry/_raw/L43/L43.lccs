               <elements>
                  <LC_Stratum id="13" ontop="0" uuid="e2680281-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>Vegetation 1</description>
                     <elements>
                        <LC_LandCoverElement id="14" uuid="e2680280-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_HerbaceousGrowthForms">
                           <name>Herbaceous growth forms</name>
                           <description>Describe a vegetation element of herbaceous growth form type</description>
                           <elements>
                              <LC_Characteristic id="39" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <cover max="100.0" min="80.0"/>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
