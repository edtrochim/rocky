<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<LC_Legend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="1" lccs_sort="0" uuid="b5a85240-84bc-11ef-8425-2cea7f8ec854" xsi:noNamespaceSchemaLocation="L43.xsd" xsi:type="LC_Legend">
   <name>Libya Legend</name>
   <description>Describe the legend</description>
   <elements>
      <LC_LandCoverClass id="2" uuid="c5aaadf3-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_LandCoverClass">
         <name>Water</name>
         <description>It corresponds to natural water bodies which are permanent feature in an area. They are further categorized based on water dynamics. </description>
         <map_code>W</map_code>
         <elements>
            <LC_HorizontalPattern id="3" uuid="c5aaadf2-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="4" ontop="0" uuid="c5aaadf1-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>Abiotic surface 1</description>
                     <elements>
                        <LC_LandCoverElement id="5" uuid="c5aaadf0-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_WaterBody">
                           <name>Water Body</name>
                           <description>Describe a water body surface element</description>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
      <LC_LandCoverClass id="6" uuid="d7fa7c13-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_LandCoverClass">
         <name>Tree-dominated area (terrestrial)</name>
         <description>This class corresponds to areas with natural semi-natural vegetation where the growth form tree is dominant. The cover percentage of the element tree is less than 20 percent that is cover ranging from 20 to 100 percent. The presence of other woody (shrubs) or non woody (herbs) growth forms is recognized with any cover percentage.</description>
         <map_code>Tt</map_code>
         <elements>
            <LC_HorizontalPattern id="7" uuid="d7fa7c12-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Natural vegetated areas are defined as areas where the vegetative cover is in balance with the abiotic and biotic forces of its biotope. Semi-natural vegetation is defined as vegetation not planted by humans but influenced by human actions.</description>
               <elements>
                  <LC_Stratum id="8" ontop="0" uuid="d7f9dfd1-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>It corresponds to areas with natural semi-natural vegetation where the growth form tree is dominant. The cover percentage of the element tree is less than 20 percent that is cover ranging from 20 to 100 percent. The presence of other woody (shrubs) or non woody (herbs) growth forms is recognized with any cover percentage.</description>
                     <elements>
                        <LC_LandCoverElement id="9" uuid="d7f9dfd0-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_Trees">
                           <name>Trees</name>
                           <description>Describe a vegetation element of trees type</description>
                           <elements>
                              <LC_Characteristic id="A" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <cover max="100.0" min="20.0"/>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
                  <LC_Stratum id="B" ontop="0" uuid="d7fa5501-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_Stratum">
                     <name>Stratum 2</name>
                     <description>Vegetation 2</description>
                     <elements>
                        <LC_LandCoverElement id="C" uuid="d7fa5500-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_Shrubs">
                           <name>Shrubs</name>
                           <description>Describe a vegetation element of shrubs type</description>
                           <elements>
                              <LC_Characteristic id="D" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Optional</presence_type>
                  </LC_Stratum>
                  <LC_Stratum id="E" ontop="0" uuid="d7fa7c11-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_Stratum">
                     <name>Stratum 3</name>
                     <description>Vegetation 3</description>
                     <elements>
                        <LC_LandCoverElement id="F" uuid="d7fa7c10-84bc-11ef-8425-2cea7f8ec854" xsi:type="LC_HerbaceousGrowthForms">
                           <name>Herbaceous growth forms</name>
                           <description>Describe a vegetation element of herbaceous growth form type</description>
                           <elements>
                              <LC_Characteristic id="10" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Optional</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
      <LC_LandCoverClass id="54" uuid="87b7b083-8d83-11f0-ae13-988d46a27cb4" xsi:type="LC_LandCoverClass">
         <name>Shrub-dominated area</name>
