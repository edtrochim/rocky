                           <description>Describe a vegetation element of herbaceous growth form type</description>
                           <elements>
                              <LC_Characteristic id="43" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
