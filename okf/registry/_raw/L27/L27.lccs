      <LC_LandCoverClass id="1C" uuid="adda7853-864a-11eb-aa79-a86daa922d76" xsi:type="LC_LandCoverClass">
         <name>Non-tree cultivation </name>
         <description>Non-tree cultivation areas include areas with small and large scale agricultural crops. The main crops grown on several farms are corn (Zea mays), rice ( Oryza sativa), sorghum (Sorghum bicolor), peanut (Arachis hypogaea), Nhemba beans (Vigna unguiculata), manioc (Manihot esculenta), cotton (Gossypium hirsutum) and sugar cane ( Saccharum officinarum). </description>
         <map_code>2</map_code>
         <elements>
            <LC_HorizontalPattern id="1D" uuid="adda7852-864a-11eb-aa79-a86daa922d76" xsi:type="LC_HorizontalPattern">
