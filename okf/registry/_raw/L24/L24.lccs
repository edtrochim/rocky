                              <LC_Characteristic id="28" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                              <LC_Characteristic id="29" uuid="cf536350-ea75-11e5-a049-780cb82883be" xsi:type="LC_UserDefinedElementCharacteristic">
                                 <name>Area Size</name>
                                 <description>Describe the user characteristic structure</description>
                                 <userid>uds_cf536350-ea75-11e5-a049-780cb82883be</userid>
                                 <LC_Property name="minimum_area_size_ha" xsi:type="LC_PropertyDouble">
                                    <value>0.4</value>
                                 </LC_Property>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                           <LC_WoodyGrowthLeafType uuid="e3aec875-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafType">
