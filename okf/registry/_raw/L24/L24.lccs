                                    <description>Describe a Broadleaved type element</description>
                                 </LC_WoodyLeafType>
                              </elements>
                           </LC_WoodyGrowthLeafType>
                           <LC_WoodyGrowthLeafPhenology uuid="e3aec874-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafPhenology">
                              <name>Woody Growth Leaf Phenology</name>
                              <description>Contains the elements of Woody Growth Leaf Phenology</description>
                              <elements>
                                 <LC_WoodyLeafPhenology uuid="7835c0f0-864b-11eb-aa79-a86daa922d76" xsi:type="LC_Deciduous">
                                    <name>Deciduous</name>
