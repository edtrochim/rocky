   <name>Sudan LCCS 2020</name>
   <description>Sudan National Land Cover Classification System</description>
   <elements>
      <LC_LandCoverClass id="17" uuid="645695b3-864a-11eb-aa79-a86daa922d76" xsi:type="LC_LandCoverClass">
         <name>Water</name>
         <description>Describe the land cover class</description>
         <map_code>WAT</map_code>
         <elements>
            <LC_HorizontalPattern id="18" uuid="645695b2-864a-11eb-aa79-a86daa922d76" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="19" ontop="0" uuid="645695b1-864a-11eb-aa79-a86daa922d76" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description/>
                     <elements>
                        <LC_LandCoverElement id="1A" uuid="645695b0-864a-11eb-aa79-a86daa922d76" xsi:type="LC_WaterBody">
                           <name>Water Body</name>
                           <description>Describe a water body surface element</description>
                           <elements>
                              <LC_Characteristic id="1B" uuid="27a2ebe1-43af-11de-bbd4-000cf147c442" xsi:type="LC_Artificiality">
                                 <name>Artificiality</name>
                                 <description>Describe the artificiality characteristic</description>
                                 <type>Natural / Artificial</type>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                           <dynamics>Flowing / Standing</dynamics>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
               <type/>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
      <LC_LandCoverClass id="1C" uuid="adda7853-864a-11eb-aa79-a86daa922d76" xsi:type="LC_LandCoverClass">
