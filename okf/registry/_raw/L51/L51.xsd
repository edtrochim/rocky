      <xs:element name="elementHorizontalSpreading" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="elementPresenceType" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="evergreenPercentage" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="extractionType" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="floatingIceType" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="forbsLeafType" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
