      <xs:element name="" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="algaeStatus" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="aphyllousPercentage" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
