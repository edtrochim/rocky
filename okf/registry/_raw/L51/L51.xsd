      <xs:element name="cover" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="deciduousLength" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:element name="deciduousPercentage" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
