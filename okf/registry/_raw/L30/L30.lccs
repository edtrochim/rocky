               <description>Describe the geographical aspects</description>
               <type>Continental</type>
            </LC_Characteristic>
            <LC_Characteristic id="1CF" uuid="b0a53ef3-50f6-11de-bcd7-000cf147c442" xsi:type="LC_Climate">
               <name>Climate</name>
               <description>Describe the climate</description>
               <termal_zone>Temperate Continental</termal_zone>
               <length_of_growing_period>Dry Semi-arid</length_of_growing_period>
            </LC_Characteristic>
