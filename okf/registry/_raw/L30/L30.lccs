                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                           <cover max="100.0" min="10.0"/>
                           <LC_WoodyGrowthLeafType id="F0" uuid="e3aec875-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafType">
                              <name>Woody Growth Leaf Type</name>
                              <description>Contains the elements of Woody Growth Leaf Type</description>
                              <elements>
                                 <LC_WoodyLeafType id="F1" uuid="408062d0-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Broadleaved">
                                    <name>Broadleaved</name>
                                    <description>Describe a Broadleaved type element</description>
                                    <percentage max="100.0" min="75.0"/>
                                 </LC_WoodyLeafType>
                              </elements>
                           </LC_WoodyGrowthLeafType>
                           <LC_WoodyGrowthLeafPhenology id="EE" uuid="e3aec874-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafPhenology">
                              <name>Woody Growth Leaf Phenology</name>
                              <description>Contains the elements of Woody Growth Leaf Phenology</description>
                              <elements>
                                 <LC_WoodyLeafPhenology id="EF" uuid="407feda0-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Deciduous">
                                    <name>Deciduous</name>
                                    <description>Describe a Deciduous leaf phenology element</description>
                                    <percentage max="100.0" min="75.0"/>
                                 </LC_WoodyLeafPhenology>
                              </elements>
                           </LC_WoodyGrowthLeafPhenology>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
      <LC_LandCoverClass id="12" uuid="40860823-fa9c-11eb-8bb1-185680280055" xsi:type="LC_LandCoverClass">
         <name>Foret mixte</name>
         <description>Forêt naturelle, dans lesquelles ni les conifères, ni les feuillus représentent plus de 75 pour cent du couvert arboré, qui englobe une terre avec un couvert arboré (ou une densité de peuplement) supérieur à 10 pour cent et d'une superficie supérieure à 0,5 ha. On retrouve principalement les espèces suivantes : chêne liège, chêne zeen, chêne liège, chêne vert, pin maritime, pin d’Alep, thuya, autres espèces.</description>
         <map_code>Am</map_code>
         <elements>
            <LC_HorizontalPattern id="13" uuid="40860822-fa9c-11eb-8bb1-185680280055" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="14" ontop="0" uuid="40860821-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>Vegetation 1</description>
                     <elements>
                        <LC_LandCoverElement id="15" uuid="40860820-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Trees">
                           <name>Trees</name>
                           <description>Describe a vegetation element of trees type</description>
