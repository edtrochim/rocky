      <LC_LandCoverClass id="1D1" uuid="d4384a20-63d7-11ec-a204-ca09a8793975" xsi:type="LC_LandCoverClass">
         <name>Boqueteau</name>
         <description>Espèce ou groupe d'espèces forestières ayant un recouvrement de 10 pour cent au minimum de l'espace boisé, une largeur minimale en cime de 15 m et d'une superficie minimale de prise en compte de 0,5 ha. On retrouve principalement les espèces suivantes: chêne liège, chêne zeen, chêne vert, acacia tortillis, pin d’Alep, pin maritime, cyprès, thuya, genévriers, mélange d'espèces.</description>
         <map_code>Arb</map_code>
         <elements>
            <LC_HorizontalPattern id="1D2" uuid="de9d4510-63d7-11ec-a204-ca09a8793975" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
