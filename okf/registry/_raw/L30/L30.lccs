                                       <description>Describe the forest plantation</description>
                                    </LC_Characteristic>
                                 </elements>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                           <cover max="0.0" min="0.0"/>
                           <LC_WoodyGrowthLeafType id="FA" uuid="e3aec875-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafType">
                              <name>Woody Growth Leaf Type</name>
                              <description>Contains the elements of Woody Growth Leaf Type</description>
                              <elements>
                                 <LC_WoodyLeafType id="FB" uuid="408ebab0-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Broadleaved">
                                    <name>Broadleaved</name>
                                    <description>Describe a Broadleaved type element</description>
                                    <percentage max="100.0" min="75.0"/>
                                 </LC_WoodyLeafType>
