                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                              <LC_Characteristic id="1D6" uuid="27a47295-43af-11de-bbd4-000cf147c442" xsi:type="LC_FloristicAspect">
                                 <name>Floristic Aspect</name>
                                 <description>Describe the floristic aspect</description>
                                 <elements>
