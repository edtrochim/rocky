      <LC_LandCoverClass id="3E" uuid="9c98a133-fa9d-11eb-8bb1-185680280055" xsi:type="LC_LandCoverClass">
         <name>Piste forestiere</name>
         <description>Chemin établi en milieu forestier, plus ou moins élaboré et rarement goudronné, construit dans un but d'exploitation industrielle ou d'activités connexes (plein air, loisir, etc.).</description>
         <map_code>Ppf</map_code>
         <elements>
            <LC_HorizontalPattern id="3F" uuid="9c98a132-fa9d-11eb-8bb1-185680280055" xsi:type="LC_HorizontalPattern">
