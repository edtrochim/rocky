               <description>Describe the climate</description>
               <termal_zone>Temperate Continental</termal_zone>
               <length_of_growing_period>Dry Semi-arid</length_of_growing_period>
            </LC_Characteristic>
            <LC_HorizontalPattern id="1DB" uuid="546c4430-63d8-11ec-a204-ca09a8793975" xsi:type="LC_HorizontalPattern">
