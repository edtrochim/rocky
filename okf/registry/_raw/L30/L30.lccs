      <LC_LandCoverClass id="75" uuid="1065c063-fa9f-11eb-8bb1-185680280055" xsi:type="LC_LandCoverClass">
         <name>Parcours steppiques</name>
         <description>Parcours formés de végétation steppique pérenne. Des ligneux bas (pseudo-steppes) ou par les graminées pérennes (steppes graminéennes). On retrouve principalement des parcours steppiques à Stipa Tenacissima, à Anthyllis sericea, Artemisia herba alba, Rantherium suaveolens, et d’autres parcours steppiques, ou encore une mosaïque de parcours et d'agriculture</description>
         <map_code>Ahp</map_code>
         <elements>
            <LC_HorizontalPattern id="76" uuid="1065c062-fa9f-11eb-8bb1-185680280055" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="77" ontop="0" uuid="1065c061-fa9f-11eb-8bb1-185680280055" xsi:type="LC_Stratum">
