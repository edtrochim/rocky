<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<LC_Legend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="1" lccs_sort="0" uuid="2c113720-fa9c-11eb-8bb1-185680280055" xsi:noNamespaceSchemaLocation="IFPON_LCMap-Legend_Updated.xsd" xsi:type="LC_Legend">
   <name>Légende de l'occupation du sol pour la Tunisie</name>
   <description>IFPON</description>
   <elements>
      <LC_LandCoverClass id="2" uuid="407c4423-fa9c-11eb-8bb1-185680280055" xsi:type="LC_LandCoverClass">
         <name>Foret de resineux</name>
         <description>Forêt naturelle, ayant une prédominance (plus de 75 pour cent du couvert arboré) d’arbres appartenant aux espèces de conifères, qui englobe une terre avec un couvert arboré (ou une densité de peuplement) supérieur à 10 pour cent et d'une superficie supérieure à 0,5 ha. On retrouve principalement les espèces suivantes: pin d’Alep, pin maritime, pin pignon, cyprès, thuya, genévriers, etc.</description>
         <map_code>Ar</map_code>
         <elements>
            <LC_HorizontalPattern id="3" uuid="407c4422-fa9c-11eb-8bb1-185680280055" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="4" ontop="0" uuid="407abd81-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>Vegetation 1</description>
                     <elements>
                        <LC_LandCoverElement id="5" uuid="407abd80-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Trees">
                           <name>Trees</name>
                           <description>Describe a vegetation element of trees type</description>
                           <elements>
                              <LC_Characteristic id="6" uuid="27a47286-43af-11de-bbd4-000cf147c442" xsi:type="LC_NaturalOrSeminaturalVegetation">
                                 <name>Natural Or Seminatural Vegetation</name>
                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                           <cover max="100.0" min="10.0"/>
                           <LC_WoodyGrowthLeafType id="EC" uuid="e3aec875-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafType">
                              <name>Woody Growth Leaf Type</name>
                              <description>Contains the elements of Woody Growth Leaf Type</description>
                              <elements>
                                 <LC_WoodyLeafType id="ED" uuid="407a9670-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Needleleaved">
                                    <name>Needleleaved</name>
                                    <description>Describe a Needleleaved type element</description>
                                    <percentage max="100.0" min="75.0"/>
                                 </LC_WoodyLeafType>
                              </elements>
                           </LC_WoodyGrowthLeafType>
                           <LC_WoodyGrowthLeafPhenology id="EA" uuid="e3aec874-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafPhenology">
                              <name>Woody Growth Leaf Phenology</name>
                              <description>Contains the elements of Woody Growth Leaf Phenology</description>
                              <elements>
                                 <LC_WoodyLeafPhenology id="EB" uuid="407a4850-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Evergreen">
                                    <name>Evergreen</name>
                                    <description>Describe an Evergreen leaf phenology element</description>
                                    <percentage max="100.0" min="75.0"/>
                                 </LC_WoodyLeafPhenology>
                              </elements>
                           </LC_WoodyGrowthLeafPhenology>
                        </LC_LandCoverElement>
                     </elements>
                     <presence_type>Mandatory</presence_type>
                  </LC_Stratum>
               </elements>
            </LC_HorizontalPattern>
         </elements>
      </LC_LandCoverClass>
      <LC_LandCoverClass id="A" uuid="40819b53-fa9c-11eb-8bb1-185680280055" xsi:type="LC_LandCoverClass">
         <name>Foret de feuillus</name>
         <description>Forêt naturelle, ayant une prédominance (plus de 75 pour cent du couvert arboré) d’arbres appartenant aux espèces feuillues, qui englobe une terre avec un couvert arboré (ou une densité de peuplement) supérieur à 10 pour cent et d'une superficie supérieure à 0,5 ha. On retrouve principalement les espèces suivantes: chêne liège, chêne zeen, chêne vert, acacia tortillis, eucalyptus, peupliers, acacias sp, etc.</description>
         <map_code>Af</map_code>
         <elements>
            <LC_HorizontalPattern id="B" uuid="40819b52-fa9c-11eb-8bb1-185680280055" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
