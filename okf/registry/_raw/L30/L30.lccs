                                 <description>Describe the natural or seminatural vegetation</description>
                              </LC_Characteristic>
                           </elements>
                           <presence_type>Mandatory</presence_type>
                           <cover max="100.0" min="10.0"/>
                           <LC_WoodyGrowthLeafType id="F5" uuid="e3aec875-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafType">
                              <name>Woody Growth Leaf Type</name>
                              <description>Contains the elements of Woody Growth Leaf Type</description>
                              <elements>
                                 <LC_WoodyLeafType id="F6" uuid="4085ba00-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Broadleaved">
                                    <name>Broadleaved</name>
                                    <description>Describe a Broadleaved type element</description>
                                    <percentage max="60.0" min="40.0"/>
                                 </LC_WoodyLeafType>
                                 <LC_WoodyLeafType id="F7" uuid="4085e110-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Needleleaved">
                                    <name>Needleleaved</name>
                                    <description>Describe a Needleleaved type element</description>
                                    <percentage max="60.0" min="40.0"/>
                                 </LC_WoodyLeafType>
                              </elements>
                           </LC_WoodyGrowthLeafType>
                           <LC_WoodyGrowthLeafPhenology id="F2" uuid="e3aec874-3572-11de-a238-000cf147c442" xsi:type="LC_WoodyGrowthLeafPhenology">
                              <name>Woody Growth Leaf Phenology</name>
                              <description>Contains the elements of Woody Growth Leaf Phenology</description>
                              <elements>
                                 <LC_WoodyLeafPhenology id="F3" uuid="408544d0-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Deciduous">
                                    <name>Deciduous</name>
                                    <description>Describe a Deciduous leaf phenology element</description>
                                    <percentage max="60.0" min="40.0"/>
                                 </LC_WoodyLeafPhenology>
                                 <LC_WoodyLeafPhenology id="F4" uuid="40856be0-fa9c-11eb-8bb1-185680280055" xsi:type="LC_Evergreen">
                                    <name>Evergreen</name>
