      <LC_LandCoverClass id="44" uuid="c6e1fa43-fa9d-11eb-8bb1-185680280055" xsi:type="LC_LandCoverClass">
         <name>Maquis arbore</name>
         <description>Végétation composée d’espèces typiques tels, chêne vert, les cistes, les bruyères et les arbousiers, etc. Il se développe sur les sols siliceux et/ou acides.</description>
         <map_code>Arm</map_code>
