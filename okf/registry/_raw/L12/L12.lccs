<LC_Legend xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="1" lccs_sort="0" uuid="97e50891-7958-11e4-bc06-10bf4816e1d5" xsi:noNamespaceSchemaLocation="Lesotho Stage3_v3.xsd" xsi:type="LC_Legend">
   <name>Lesotho preliminar</name>
   <description>Describe the legend</description>
   <elements>
      <LC_LandCoverClass id="2" uuid="a87af1b0-7958-11e4-bc06-10bf4816e1d5" xsi:type="LC_LandCoverClass">
         <name>Urban area</name>
         <description>Relatively larger urban built-up areas, commonly with presence of trees</description>
         <map_code>UA1</map_code>
         <elements>
            <LC_HorizontalPattern id="3" uuid="eaf55910-795b-11e4-bc06-10bf4816e1d5" xsi:type="LC_HorizontalPattern">
               <name>Horizontal Pattern 1</name>
               <description>Describe the horizontal pattern</description>
               <elements>
                  <LC_Stratum id="4" ontop="0" uuid="ebaee510-795b-11e4-bc06-10bf4816e1d5" xsi:type="LC_Stratum">
                     <name>Stratum 1</name>
                     <description>Abiotic surface 1</description>
                     <elements>
                        <LC_LandCoverElement id="5" uuid="f8b31bf0-795b-11e4-bc06-10bf4816e1d5" xsi:type="LC_Building">
                           <name>Building</name>
                           <description>Describe a building element</description>
