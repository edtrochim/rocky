{
 "type": "object",
 "additionalProperties": false,
 "required": [
  "patterns",
  "rationale",
  "confidence",
  "evidence",
  "open_questions",
  "nearest_examples",
  "examples_note",
  "land_use_hint",
  "status"
 ],
 "properties": {
  "status": {
   "type": "string",
   "enum": [
    "proposed",
    "disputed"
   ]
  },
  "confidence": {
   "type": "number",
   "minimum": 0,
   "maximum": 1
  },
  "land_use_hint": {
   "type": "string"
  },
  "rationale": {
   "type": "string"
  },
  "examples_note": {
   "type": "string",
   "description": "which registry examples were used and how this class differs from each"
  },
  "nearest_examples": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "registry node ids used, e.g. registry:L16:311"
  },
  "evidence": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "row_path",
     "quote"
    ],
    "properties": {
     "row_path": {
      "type": "string"
     },
     "quote": {
      "type": "string"
     }
    }
   }
  },
  "open_questions": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "patterns": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "cover",
     "occurrence",
     "strata"
    ],
    "properties": {
     "cover": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      ]
     },
     "occurrence": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "type": "array",
        "items": {
         "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
       }
      ]
     },
     "strata": {
      "type": "array",
      "items": {
       "type": "object",
       "additionalProperties": false,
       "required": [
        "presence",
        "onTop",
        "elements"
       ],
       "properties": {
        "presence": {
         "type": "string",
         "enum": [
          "fixed",
          "exclusive",
          "conditionalTemporal",
          "precluded"
         ]
        },
        "onTop": {
         "type": "boolean"
        },
        "elements": {
         "type": "array",
         "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
           "ref",
           "presence",
           "cover",
           "height",
           "properties",
           "characteristics",
           "evidence",
           "confidence"
          ],
          "properties": {
           "ref": {
            "type": "string",
            "description": "an LChS element reference from the vocabulary, e.g. LC_Tree"
           },
           "presence": {
            "type": "string",
            "enum": [
             "fixed",
             "exclusive",
             "conditionalTemporal",
             "precluded"
            ]
           },
           "cover": {
            "anyOf": [
             {
              "type": "null"
             },
             {
              "type": "array",
              "items": {
               "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
             }
            ]
           },
           "height": {
            "anyOf": [
             {
              "type": "null"
             },
             {
              "type": "array",
              "items": {
               "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
             }
            ]
           },
           "properties": {
            "type": "object",
            "additionalProperties": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "array",
               "items": {
                "type": "number"
               },
               "minItems": 2,
               "maxItems": 2
              }
             ]
            }
           },
           "characteristics": {
            "type": "array",
            "items": {
             "type": "object",
             "additionalProperties": false,
             "required": [
              "ref",
              "fields"
             ],
             "properties": {
              "ref": {
               "type": "string"
              },
              "fields": {
               "type": "object",
               "additionalProperties": {
                "type": "string"
               }
              }
             }
            }
           },
           "evidence": {
            "type": "string"
           },
           "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
           }
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
